#define BossBGMEntry(UnitId,SongId) "BYTE UnitId 0 0 0; SHORT SongId 0"
#define BossBGMTerminator "BYTE 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF"






ALIGN 4
BossBGMTable:
//Prologue
BossBGMEntry(EmiliaBoss, FE5BossBattleID)
//Chp1
BossBGMEntry(0x46, FE5BossBattleID)
//Chp2
BossBGMEntry(0x4A, FE5BossBattleID)
BossBGMEntry(0x19, 0x22)

//Chp3
BossBGMEntry(0x47, FE5BossBattleID)
BossBGMEntry(0x4C, FE5BossBattleID)
BossBGMEntry(0x48, FE5BossBattleID)

//Chp4


//Chp5
BossBGMEntry(0x4D, FE5BossBattleID)


//Chp6
BossBGMEntry(0x45, FE5BossBattleID)


//Chp7
BossBGMEntry(0x4E, FE5BossBattleID)


BossBGMTerminator

PUSH

ORG $72908
POIN BossBGMTable

POP
