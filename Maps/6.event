// Map Data Installer Generated by tmx2ea

{

ALIGN 4
MapData:
  #incbin "6_data.dmp"

SetChapterData(0x6, 9, 0, 0xD, 9, 0x1F, MapData, 0xDB, 0x0, 0x20)

ALIGN 4
Map_Change_0:
  SHORT $C1C $C20 $C24 $D1C $D20 $D24

ALIGN 4
