//Darkened palettes
#incbin "BluePal.dmp"
#incbin "RedPal.dmp"
#incbin "GreenPal.dmp"
#incbin "GrayPal.dmp"

ORG 0xA1738C//MMB Palettes
#incbin "BluePal.dmp"
#incbin "RedPal.dmp"
#incbin "GreenPal.dmp"
