#include "Images/Installer.event"

ALIGN 4
MenuTiles:
#incbin "MenuTiles.dmp"

ALIGN 4
MenuTilesPal:
#incbin "BluePal.dmp"

ALIGN 4
BobPrepMenuItemsUnitHeader:
#incbin "Dmp/PrepMenuItemsUnitHeader.dmp"

ALIGN 4
BluePalIm:
#incbin "BluePal.dmp"

#define MenuTilesPaletteBlue  BluePalIm
#define MenuTilesPaletteRed   BluePalIm + 0x20
#define MenuTilesPaletteGreen BluePalIm + 0x40
#define MenuTilesPaletteGray  BluePalIm + 0x60

PUSH

ORG 0x5B6470
POIN MenuTiles
POIN MenuTiles
POIN MenuTiles
POIN MenuTiles

ORG 0x5B6BB4//Palettes
#incbin "BluePal.dmp"
#incbin "RedPal.dmp"
#incbin "GreenPal.dmp"
#incbin "GrayPal.dmp"

//Darkened palettes
#incbin "BluePal.dmp"
#incbin "RedPal.dmp"
#incbin "GreenPal.dmp"
#incbin "GrayPal.dmp"

ORG 0xA1738C//MMB Palettes
#incbin "BluePal.dmp"
#incbin "RedPal.dmp"
#incbin "GreenPal.dmp"

//Prep screen
ORG 0x86C40
WORD 0x8B175CC

//Shops
ORG 0xB4E14
WORD 0x8B175CC

//Options menu
ORG 0x86DAC
WORD 0x8B175CC

//Status menu
ORG 0x8E194
WORD 0x8B175CC

//idk (debug startup menu uses this)
ORG 0x86BF8
WORD 0x8B175CC

ORG 0x5A09A8
#incbin "Forecast.dmp"

ORG $9AD648//Anims Off
#incbin "BluePal.dmp"
#incbin "RedPal.dmp"
#incbin "GreenPal.dmp"
#incbin "GrayPal.dmp"

//SupportMenu
ORG 0xA1DD0C
#incbin "Dmp/SupportMenuGraphics.dmp"

ORG $036D2C //main palette
POIN MenuTilesPal

ORG 0x36D2C
POIN MenuTilesPal

ORG 0x98468
POIN BobPrepMenuItemsUnitHeader
ORG 0x98528
POIN MenuTilesPaletteBlue

POP





