LaplusCheckShike:
CHECK_ACTIVE
	SVAL s1 0x2F
	BEQ 1 s1 sC
	ENUF 24 // unset completion flag if unit selected isn't Miko
	GOTO 2
	LABEL 1
CHECK_DEPLOYED 0x2E
SVAL s7 0
BEQ 2 sC s7
	Text(LaplusLuiShike)
	LABEL 2
NoFade
ENDA

