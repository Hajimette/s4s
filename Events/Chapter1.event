	SVAL s7 1
	BEQ 8 sC s7
	Text(FaunmeiCreature) //Flag check
	GOTO 67
	LABEL 8
	Text(ReineWTF)
	LABEL 67
	NoFade
	ENDA

    TimeToGo:
	CAM1 [1,12]
	LOAD1 1 Cooked
	CAM1 [1,3]
	CHECK_EVENTID 0x78 //Checks if triggered 78
	SVAL s7 0
	BEQ 21 sC s7
	LOAD1 0x1 ReineUnit1
	
	LABEL 21
	ENUT 4
	NoFade
	ENDA






