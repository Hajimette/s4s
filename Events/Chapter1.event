BeginningScene:
	SetBackground(Dungeon2)
	FadeBackBlack
	TalkConvo(AmeliaBum)
	FadeBlack
	CLEAN
	CAM1 [19,7]
	LOAD1 0x1 EnemyUnits
	FadeBackBlack
	LOAD1 0 Chapter1Units //Unfilled 
	Highlight(0x46)
	STAL 10
	PlayEmotionEffect(0x46,DotDotDotEffect)
	STAL 45
	CHECK_EVENTID 0x78 //Checks if triggered 78
	SVAL s7 1
	BEQ 8 sC s7
	MusicChange(0x13)
	TalkConvo(NoirIntro)
	SCOORD sB [19, 8]
	MOVE 0x05 (-2) [21,8]
	STAL 120
	DISA_IF 0xAA
	Text(Noirhasabruhmoment)
	CAM1 [2,3]
	LOAD1 0 PlayerUnits
	TalkConvo(ZetaChapter1Desc)
	GOTO 2
	LABEL 8
	MusicChange(0x14)
	TalkConvo(NoirIntroAlerted)
	SCOORD sB [19, 8]
	MOVE 0x05 (-2) [21,8]
	STAL 120
	DISA_IF 0xAA
	Text(NoirhasabruhmomentAlert)
	CAM1 [2,3]
	LOAD1 0 PlayerUnits
	TalkConvo(ZetaChapter1DescAlerted)
	LABEL 2
	TextBox(RequiredEscapesChapter1)
	EnactAutoRepair
	ENDA
	
	
	
