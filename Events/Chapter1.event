Traps1:
	ENDTRAP
	ALIGN 4

Traps2:
	ENDTRAP
	ALIGN 4

BeginningScene:
	SetBackground(FieldSunset)
	FadeBackBlack
	TalkConvo(AmeliaBum)
	FadeBlack
	CLEAN
	CAM1 [4,9]
	MusicChange(0x28)
	FadeBackBlack
	LOAD1 0x1 ReineUnit1 
	MOVE 15 0x2 [5,10]
	TalkConvo(ReineIntro)
	LOAD1 0x1 ReineGetsJumped
	MusicChange(0x31)
	MOVE 15 0x2 [4,8]
	STAL 60
	PlayEmotionEffect(0x2,ExclamationEffect)
	STAL 45
	TalkConvo(ReineWTF)
	MOVE 15 0xAB [4,7]
	ENUN
	StartBattle
	NormalDamage(0xAB, 5)
	EndAttack
	FIGHT_MAP 0xAB 0x02 RottenClaw False
	STAL 45
	StartBattle
	NormalDamage(0x02, 80)
	EndAttack
	FIGHT_MAP 0x02 0xAB Fire False
	DISA 0xAB
	LOAD1 1 Chapter1Units
	TalkConvo(ReineBruh)
	CAM1 [5,14]
    LOAD1 0x1 PlayerUnits
	STAL 60
	PlayEmotionEffect(Amelia,DotDotDotEffect)
	STAL 45
	TalkConvo(AmeWth)
	CAM1 [5,14]
    ENUN
	CUSA 0x2
	LOAD1 0x1 EnemyUnits
	ENUN
	SetUnitStatus(0x2,SwordExp,1)
	SetUnitStatus(0x2,LightExp,0)
	SetUnitStatus(0x2,StaffExp,0)
	
	
	
	ENDA
	
	
	
	FaunmeiSpawn:
	MusicChange(0x03)
	STAL 45
	CAM1 [15,8]
	LOAD1 0x1 Faunmei
	ENUN
	TalkConvo(FaunmeiAnimals)
	LOAD1 0x1 Creature
	TalkConvo(FaunmeiCreature)
	LOAD1 0x1 TheyCome
	ENUN
	PlayEmotionEffect(Fauna,ExclamationEffect)
	PlayEmotionEffect(Mumei,ExclamationEffect)
	STAL 45
	LOAD1 0x1 MoreCome
	TalkConvo(FaunmeisBruhMoment)
	MOVE 15 Mumei [17,5]
	MOVE 15 Fauna [15,8]
	PlayEmotionEffect(Mumei,ExclamationEffect)
	STAL 45
	MusicChange(0x31)
	TalkConvo(MumeiGetsSmoked)
	MOVE 15 Fauna [16,6]
	ENUN
	TalkConvo(FaunmeiFight)
	CUSA Mumei
	CUSA Fauna
	
	ENDA
	
	ReineAmeliaTalk:
	MusicChange(0x17)
	TalkConvo(ReineAmeliaTalkCh1)
	ENDA
	
	MoreBodies:
	LOAD2 1 CorpsesArise
	ENDA

    TimeToGo:
	LOAD2 1 Cooked
	ENUT 4
	ENDA




Chp1House:
SetBackground(House1)
TalkConvo(Chp1HouseText)
ENDA

Chp1VillageEvent:
FadeBlack
SetBackground(House1)
FadeBackBlack
TalkConvo(Chp1HouseText)
FadeBlack
CLEAN
FadeBackBlack
GiveItem(0x76,0xFFFF)
NoFade
ENDA

ALIGN 4
ReineChp1DeathNotice:
	CHECK_ACTIVE
	SVAL s1 0x2
	BEQ 1 s1 sC
	ENUF 7 // unset completion flag if unit selected isn't Miko
	GOTO 2
	LABEL 1
	TextBox(ReineTutorial)
	LABEL 2
	NoFade
ENDA




EndingScene:
EndOfEscapeRoutineASMC
EnactAutoRepair
	MNC2 2
	NoFade
	ENDA
