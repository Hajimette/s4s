ReineChp1DeathNotice:
	CHECK_ACTIVE
	SVAL s1 0x32
	BEQ 1 s1 sC
	ENUF 7 // unset completion flag if unit selected isn't Miko
	GOTO 2
	LABEL 1
	Text(ReineTutorial)
	LABEL 2
	NoFade
ENDA




