SetChapterEvents(Chapter1Event, PointerList)

PointerList:
	POIN TurnBasedEvents
	POIN CharacterBasedEvents
	POIN LocationBasedEvents
	POIN MiscBasedEvents
	POIN Dunno1 Dunno2 Dunno3 Tutorial
	POIN Traps1 Traps2
	POIN PlayerUnits PlayerUnits  //This unit group determines the number and position of deployment slots when there is a prep screen
	POIN $0 $0 $0
	POIN $0 $0 $0
	POIN BeginningScene EndingScene

TurnBasedEvents:
	TurnEventPlayer(0, FaunmeiSpawn, 3)
	TurnEventPlayer(0, MoreBodies, 5)
	TurnEventPlayer(0, TimeToGo, 7)
	END_MAIN

ALIGN 32
CharacterBasedEvents:
	CharacterEventBothWays(8, ReineAmeliaTalk, Amelia, 0x2)
	
	END_MAIN

MiscBasedEvents:
	CauseGameOverIfLordDies
	END_MAIN

LocationBasedEvents:
	House(0,Chp1House,11,12)
	Village(0x10,Chp1VillageEvent,2,3)
	Escape(7,0)
	Escape(8,0)
	END_MAIN

Dunno1:
	AFEV 0x7 ReineChp1DeathNotice 0

	END_MAIN

Dunno2:

	END_MAIN

Dunno3:

	END_MAIN

Tutorial:

	END_MAIN

