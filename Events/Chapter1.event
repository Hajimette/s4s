SetChapterEvents(Chapter1Event, PointerList)

PointerList:
	POIN TurnBasedEvents
	POIN CharacterBasedEvents
	POIN LocationBasedEvents
	POIN MiscBasedEvents
	POIN Dunno1 Dunno2 Dunno3 Tutorial
	POIN Traps1 Traps2
	POIN PlayerUnits PlayerUnits  //This unit group determines the number and position of deployment slots when there is a prep screen
	POIN $0 $0 $0
	POIN $0 $0 $0
	POIN BeginningScene EndingScene

TurnBasedEvents:

	END_MAIN

ALIGN 32
CharacterBasedEvents:

	END_MAIN

MiscBasedEvents:
	CauseGameOverIfLordDies
	END_MAIN

LocationBasedEvents:

	END_MAIN

Dunno1:

	END_MAIN

Dunno2:

	END_MAIN

Dunno3:

	END_MAIN

Tutorial:

	END_MAIN

PlayerUnits:
        UNIT Amelia 0x1 Amelia Level(1,Ally,False) [3,16] 0x0 0x0 1 REDA5R14 [0,0] NoAI

	UNIT

EnemyUnits:

        UNIT 0xAA 0x52 0x53 Level(1,Enemy,True) [1,8] 0x0 0x0 0x0 0x1 [RottenClaw] NoAI
 
	UNIT

ReineUnit:
	UNIT Reine 0x4 Amelia Level(1,NPC,False) [4,8] 0x0 0x0 0x0 0x0 [Fire,SlimSword,Vulnerary] NoAI
	
	UNIT

Faunmei:
	UNIT Mumei 0xD Amelia Level(1,NPC,False) [19,9] 0x0 0x0 1 REDA14R9 [IronSword,Lockpick] NoAI
	UNIT Fauna 0x1A Amelia Level(3,NPC,False) [19,10] 0x0 0x0 1 REDA14R10 [IronBow,Vulnerary] NoAI
	
	UNIT

Traps1:
	ENDTRAP
	ALIGN 4

Traps2:
	ENDTRAP
	ALIGN 4

BeginningScene:
	SetBackground(FieldSunset)
	FadeBackBlack
	TalkConvo(AmeliaBum)
	FadeBlack
	EraseBackground
	CAM1 [15,8]
	MusicChange(0x03)
	FadeBackBlack
	LOAD1 0x1 Faunmei
	TalkConvo(FaunmeiAnimals)
	//LOAD1 0x1 ReineUnit load Reine in walking from where Amelia came from


	
	
    LOAD1 0x1 PlayerUnits
	PlayEmotionEffect(Amelia,DotDotDotEffect)
	STAL 45
	TalkConvo(AmeWth)
	MusicChange(0x31)
	CAM1 [5,14]
        ENUN


	LOAD1 0x1 EnemyUnits
	ENUN
	
	ENDA

EndingScene:
	MNC2 2
	NoFade
	ENDA
