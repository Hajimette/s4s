// Miko Selection Tutorial
ALIGN 4
MikoTutorialEvent:
	CHECK_ACTIVE
	SVAL s1 Miko
	BEQ 1 s1 sC
	ENUF 7 // unset completion flag if unit selected isn't Miko
	GOTO 2
	LABEL 1
	TalkConvo(MikoSelectTutorial)
	TextBox(MikoTutorial)
	LABEL 2
	NoFade
ENDA

ALIGN 4
PolkaTutorialEvent:
CHECK_ACTIVE
	SVAL s1 0x8
	BEQ 1 s1 sC
	ENUF 0xB // unset completion flag if unit selected isn't Miko
	GOTO 2
	LABEL 1
	TextBox(PolkaTutorial)
	LABEL 2
	NoFade
ENDA







