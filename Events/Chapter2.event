		ENUN

	ENDA

// Miko Selection Tutorial
ALIGN 4
MikoTutorialEvent:
	CHECK_ACTIVE
	SVAL s1 Miko
	BEQ 1 s1 sC
	ENUF 7 // unset completion flag if unit selected isn't Miko
	GOTO 2
	LABEL 1
	TalkConvo(MikoSelectTutorial)
	TextBox(MikoTutorial)
	LABEL 2
	NoFade
ENDA







EndingScene:
	MNC2 3
	NoFade
	ENDA