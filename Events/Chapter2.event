BeginningScene:
        
		
		LOAD1 0x1 EnemyUnits
	ENUN
	CAM1 [4,17]
		FadeBackBlack
		LOAD1 0 PlayerUnits
        ENUN
		STAL 45
		CAM1 [21,3]
		
