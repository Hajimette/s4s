EndingScene:
EnactAutoRepair
	FadeBlack
	MusicChange(0x2E)
	SetBackground(Lava)
	FadeBackBlack
	Text(AmeDone)
	FadeBlack
	SOUN 0xB4
	SetBackground(Field1)
	FadeBackBlack
	SOUN 0xB5
	Text(TimetoGo)
	FadeBlack
MusicChange(0x5F)
LOMA 0x4B
CLEARALL
CAM1 [9,8]
LOAD1 1 CalliopeChp1
FadeBackBlack
STAL 60
LOAD1 1 ReapergetsjumpedChp1
PlayEmotionEffect(0x23,SweatEffect)
STAL 45
Text(CalliTrippinBruh)
LOAD1 1 Sheiscoming
ENUN
Text(SHEAppears)

STAL 60
Text(CalliBruhMoment)
CUSE 0x23
	FadeBlack
	MNC2 1
	NoFade
	ENDA
	
	
	
	
	
	
	
	
	
	
	
	
