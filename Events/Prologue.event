	ALIGN 4

BeginningScene:

	LOMA 0x4D 
	CAMERA [13,11]
	MUSS 0x4C
	LOAD1 0x1 GrassCutsceneUnit
	FadeBackBlack
	ENUT 7
	ENUT 8
	ENUT 9
	
	LABEL 10
	ASMC 0x8003D21 //Text_ResetTileAllocation
	CallMenu(PrologueMenu)
	
	BEQ 2 sC s7 //Jumps to label 2, 1RN 
	
	SVAL s7 1
	BEQ 3 sC s7  //Casual
	
	
	SVAL s7 2
	BEQ 4 sC s7 //Fixed
	
	 
	SVAL s7 3
	BEQ 5 sC s7 //Reset
	
	SVAL s7 4
	BEQ 6 sC s7 //Beging
	
	
	LABEL 2
	ENUT 0xB1 //1RN
	ENUF 7
	GOTO 10
	
	Label 3
	ENUT 0xB0 //Filthy Casual
	ENUF 8
	GOTO 10
	
	LABEL 4
	ENUT 0xEF //Fixed
	ENUF 9
	GOTO 10
	
	LABEL 5
	TextBox(FlagsReset)
	TEXTEND
	REMA
	ENUF 0xB0
	ENUF 0xB1
	ENUF 0xEF
	ENUT 7
	ENUT 8
	ENUT 9
	GOTO 10
	
	LABEL 6
	TextBox(AreYouSure)
	CallMenu(ImSureMenu)
	SVAL s7 1
	BNE 10 sC s7 // Go back to LABEL 10 if yes isn't selected

     //this is where the contents after LABEL 8 would go, no longer needing LABEL 8.	
	
	STAL 180

	LOAD1 0x1 AmeGrass
	STAL 20
	PlayEmotionEffect(Amelia,DotDotDotEffect)
	STAL 45
	TalkConvo(AmeliaOldLady)
	LOAD1 0x1 BrigandsCutscene
	PlayEmotionEffect(0xAA,ExclamationEffect)
	STAL 45
	SCOORD sB [13, 8]
	MOVE 0x1E (-2) [12,9] //Ame moves to the tree
	SCOORD sB [8, 10]
	MOVE 0x1E (-2) [10,13]
	SCOORD sB [11, 10]
	MOVE 0x1E (-2) [10,12]
	SCOORD sB [14, 8]  //Old lady moves next to Amelia
	MOVE 0x1E (-2) [13,10]
	MusicChange(0x3E7)
	STAL 60
	Highlight(Amelia)
	TalkConvo(BrigandAme)
	SCOORD sB [9,9]
	MOVE 0x1E (-2) [10,9]
	TalkConvo(BrigandANGRY)
	SCOORD sB [10,9]
	MOVE 0x1E (-2) [11,9]
	WARPOUT [12,9]
	REMOVEUNIT Amelia
	ENDWARP
	
	WARPIN [14,9]
	LOAD1 1 AmeliaCutscene
	ENDWARP
	
	TalkConvo(AmeCounter)
	
	WARPOUT [14,9]
	REMOVEUNIT Amelia
	ENDWARP
	
	FADI 60
	CLEARALL
	MuteMusic
	LOMA 0x4E
	CAMERA [4,5]
	LOAD1 1 SansCutin
	FadeBackBlack
	WARPIN [4,5]
	LOAD1 1 AmeliaCalli
	STAL 120
	MusicChange(0x318)
	TalkConvo(AmeEnter)
	SCOORD sB [4, 5]
	MOVE 0x1E (-2) [8,5]
	STAL 30
	LOAD1 1 SansMove
	SCOORD sB [16, 6]
	MOVE 0x1E (-2) [0,17]
	STAL 60
	DISA 0xB8
	PlayEmotionEffect(Amelia,QuestionEffect)
	STAL 45
	TalkConvo(AmeQuestion)
	CAMERA [7,12]
	SCOORD sB [8, 5]
	MOVE 0x1E (-2) [10,13]
	LOAD1 1 CalliopeIntervenes
	MOVE 15 0x23 [10,12]
	ENUN
	TalkConvo(CalliopeTalk)
	WARPIN [11,12]
	LOAD1 1 SansWarpsIn
	ENDWARP
	
	
	FadeBlack
	LOMA 0x0
	FadeBackBlack

	LOAD1 0x1 PlayerUnits
	ENUN

	LOAD2 0 EnemyUnits
        ENUN

	ENDA

EndingScene:
	MNC2 1
	NoFade
	ENDA