BeginningScene:

	LOMA 0x4D 
	CAMERA [13,11]
	MUSS 0x4C
	LOAD1 0x1 GrassCutsceneUnit
	FadeBackBlack
	ENUT 7
	ENUT 8
	ENUT 9
	
	LABEL 10
	ASMC 0x8003D21 //Text_ResetTileAllocation
	CallMenu(PrologueMenu)
	
	BEQ 2 sC s7 //Jumps to label 2, 1RN 
	
	SVAL s7 1
	BEQ 3 sC s7  //Casual
	
	
	SVAL s7 2
	BEQ 4 sC s7 //Fixed
	
	 
	SVAL s7 3
	BEQ 5 sC s7 //Reset
	
	SVAL s7 4
	BEQ 6 sC s7 //Beging
	
	
	LABEL 2
	ENUT 0xB1 //1RN
	ENUF 7
	GOTO 10
	
	Label 3
	ENUT 0xB0 //Filthy Casual
	ENUF 8
	GOTO 10
	
	LABEL 4
	ENUT 0xEF //Fixed
	ENUF 9
	GOTO 10
	
	LABEL 5
	TextBox(FlagsReset)
	TEXTEND
	REMA
	ENUF 0xB0
	ENUF 0xB1
	ENUF 0xEF
	ENUT 7
	ENUT 8
	ENUT 9
	GOTO 10
	
	LABEL 6
	TextBox(AreYouSure)
	CallMenu(ImSureMenu)
	SVAL s7 1
	BNE 10 sC s7 // Go back to LABEL 10 if yes isn't selected

     //this is where the contents after LABEL 8 would go, no longer needing LABEL 8.	
	
	STAL 180

	LOAD1 0x1 AmeGrass
	STAL 20
	PlayEmotionEffect(Amelia,DotDotDotEffect)
	STAL 45
	TalkConvo(AmeliaOldLady)
	LOAD1 0x1 BrigandsCutscene
	PlayEmotionEffect(0xAA,ExclamationEffect)
	STAL 45
	SCOORD sB [13, 8]
	MOVE 0x1E (-2) [12,9] //Ame moves to the tree
	SCOORD sB [8, 10]
	MOVE 0x1E (-2) [10,13]
	SCOORD sB [11, 10]
	MOVE 0x1E (-2) [10,12]
	SCOORD sB [14, 8]  //Old lady moves next to Amelia
	MOVE 0x1E (-2) [13,10]
	MusicChange(0x3E7)
	STAL 60
	Highlight(Amelia)
	TalkConvo(BrigandAme)
	SCOORD sB [9,9]
	MOVE 0x1E (-2) [10,9]
	TalkConvo(BrigandANGRY)
	SCOORD sB [10,9]
	MOVE 0x1E (-2) [11,9]
	WARPOUT [12,9]
	REMOVEUNIT Amelia
	ENDWARP
	
	WARPIN [14,9]
	LOAD1 1 AmeliaCutscene
	ENDWARP
	
	TalkConvo(AmeCounter)
	
	WARPOUT [14,9]
	REMOVEUNIT Amelia
	ENDWARP
	
	FADI 60
	CLEARALL
	MuteMusic
	LOMA 0x4E
	CAMERA [4,5]
	LOAD1 1 SansCutin
	FadeBackBlack
	WARPIN [4,5]
	LOAD1 1 AmeliaCalli
	STAL 120
	MusicChange(0x318)
	TalkConvo(AmeEnter)
	SCOORD sB [4, 5]
	MOVE 0x1E (-2) [8,5]
	STAL 30
	LOAD1 1 SansMove
	SCOORD sB [16, 6]
	MOVE 0x1E (-2) [0,17]
	STAL 60
	DISA 0xB8
	PlayEmotionEffect(Amelia,QuestionEffect)
	STAL 45
	TalkConvo(AmeQuestion)
	CAMERA [7,12]
	SCOORD sB [8, 5]
	MOVE 0x1E (-2) [10,14]
	LOAD1 1 CalliopeIntervenes
	MOVE 15 0x23 [10,13]
	ENUN
	TalkConvo(CalliopeTalk)
	WARPIN [11,13]
	LOAD1 1 SansWarpsIn
	ENDWARP
	TEXTSTART
	TextShow MoriExplains
	TEXTEND
	MOVE 15 0xB7 [12,11]
	ENUN
	MOVE 15 0xB7 [12,14]
	ENUN
	MOVE 15 0xB7 [13,13]
	ENUN
	TEXTCONT
	TEXTEND
	REMA
	BREAKING_SACRED_STONE Amelia
	PlayEmotionEffect(Amelia,ExclamationEffect)
	PlayEmotionEffect(0x23,QuestionEffect)
	STAL 45
	MuteMusic
	TalkConvo(AmePanik)
	SOUN 0x13B
	GetUnitStatus(0xB7,State)
SetUnitStatus(0xB7,State,0x01000000)
TalkConvo(WhatThe)
CUSE 0xb7
SetUnitStatus(0xB7,State,0)
	MOVE 15 0xB7 [11,13]
	ENUN
	StartBattle
	MissedAttack(1,0)
	CriticalHit(0,80)
	EndAttack
	FIGHT_MAP 0x23 0xB7 IronSword False
	DISA_IF 0xB7
	MusicChange(FE5CrisisID)
	SOUN 0x13B
	SetUnitStatus(0xBD,State,0x01000000)
	
	SetUnitStatus(0xBB,State,0x01000000)
	
	TalkConvo(HUH)
	GiveItem(Rapier,Amelia)
	
    SetUnitStatus(0xAA,State,0x01000000)
	
	SetUnitStatus(0xBD,State,0)
	
	SetUnitStatus(0xBB,State,0)
	
	CUSE 0xbd
	CUSE 0xbb
	CUSE 0xAC
	CUSE 0xAD
	
	MOVE 15 Amelia [14,14]
	
	MOVE 20 0x23 [13,14]
	MOVE 15 0xBD [12,14]
	MOVE 15 0xBB [10,12]
	SetUnitStatus(0xB7,State,0)
	ENUN
	StartBattle
	NormalDamage(0x23, 80)
	EndAttack
	FIGHT_MAP 0x23 0xBD Ricky False
	CUSE 0xAA
	MOVE 15 0xAA [9,5]
	MOVE 15 0xAC [10,4]
	MOVE 15 0xAD [8,4]
	SetUnitStatus(0xAA,State,0)
	TalkConvo(gtfo)
	MOVE 20 Amelia [20,17]
	
	MOVE 15 0xBB [11,13]
	MOVE 20 0x23 [12,13]
	ENUN
	StartBattle
	NormalDamage(0x23,80)
	EndAttack
	FIGHT_MAP 0x23 0xBB Ricky False
	
	
	MOVE 20 0x23 [9,9]
	CAM1 [9,9]
	TalkConvo(bruh)
	
	FadeBlack
	CLEARALL
	LOMA 0x0
	CAM1 [7,3]
	FadeBackBlack
	
	SOUN 0xB1
	TILECHANGE 0
	LOAD1 0x1 PlayerUnits
	ENUN
	SOUN 0xB1
	TILEREVERT 0
	TalkConvo(AmeliasBruhMoment)
	
	CAMERA [6,14]
	LOAD2 0 EnemyUnits
    ENUN
	CAMERA [7,3]
	PlayEmotionEffect(Amelia,SweatEffect)
	TalkConvo(TimetoLeave)


	ENDA

EndingScene:
	FadeBlack
	MusicChange(0x2E)
	SetBackground(Lava)
	FadeBackBlack
	TalkConvo(AmeDone)
	FadeBlack
	SOUN 0xB4
	SetBackground(Field1)
	FadeBackBlack
	SOUN 0xB5
	TalkConvo(TimetoGo)
	FadeBlack
	MNC2 1
	NoFade
	ENDA