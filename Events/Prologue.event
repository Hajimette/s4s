EndOfEscapeRoutineASMC
EnactAutoRepair
	FadeBlack
	SetBackground(0x45)
	FadeBackBlack
	CHECK_ALIVE 0x10  //RBC
	SVAL s7 0
	BEQ 2 sC s7 //Checks if rbc is alive
	CHECK_ALIVE 0x11 //Risu
	SVAL s7 0
	BEQ 3 sC s7  //Checks after if Treerat is alive
	CHECK_EVENTID 0x78 //Checks if both alive and triggered 78
	SVAL s7 0
	BEQ 8 sC s7 //Checks for flag 78
	MusicChange(0x31)
	Text(PrologueWeSurvivedbutwealertedtheguardbro)
	GOTO 67
	LABEL 8
	MusicChange(0x2E)
	Text(PrologueWeVENTEDandescaped)
	GOTO 67
	LABEL 2 //if RBC is dead checks if Risu is alive
	CHECK_ALIVE 0x11 //Risu
	SVAL s7 0
	BEQ 4 sC s7
	CHECK_EVENTID 0x78
	SVAL s7 0
	BEQ 9 sC s7 //Checks for flag 78
	MusicChange(0x2F)
	Text(RBCDeadRisuAliveTrigger) //TEXT HERE IF RISU IS ALIVE BUT RBC DEAD
	GOTO 67
	LABEL 9
	MusicChange(0x2F)
	Text(RBCDeadRisuAliveNoTrigger)   //Rbc dead and no 78 trigger
	GOTO 67
	LABEL 3// RBC alive but Risu Dead
	CHECK_EVENTID 0x78
	SVAL s7 0
	BEQ 11 sC s7 //Checks for flag 78
	MusicChange(0x2F)
	Text(RisuDeadTrigger)  //Text
	GOTO 67
	LABEL 11
	MusicChange(0x2F)
	Text(RisuDeadNoTrigger)  //Text
GOTO 67	
	LABEL 4 //This event plays if both Risu and RBC are dead
	CHECK_EVENTID 0x78
	SVAL s7 0
	BEQ 1 sC s7 //Checks for flag 78
	MusicChange(0x31)
	Text(RBCRISUDEADTRIGGER) // ADD TEXT HERE FOR TREERAT/RISU DEATH BUT FLAG ON
	GOTO 67
	LABEL 1 //Label if 78 is off and Treerat/RBC is dead
	MusicChange(0x31)
	Text(RBCRISUDEADNOTRIGGER)
	LABEL 67
	
	
