	ALIGN 4

BeginningScene:

	LOMA 0x4D 
	CAMERA [13,11]
	MUSS 0x4C
	LOAD1 0x1 GrassCutsceneUnit
	FadeBackBlack
	STAL 240

	LOAD1 0x1 AmeGrass
	STAL 20
	PlayEmotionEffect(Amelia,DotDotDotEffect)
	STAL 45
	TalkConvo(AmeliaOldLady)
	LOAD1 0x1 BrigandsCutscene
	PlayEmotionEffect(0xAA,ExclamationEffect)
	STAL 45
	SCOORD sB [13, 8]
	MOVE 0x1E (-2) [12,9] //Ame moves to the tree
	SCOORD sB [8, 10]
	MOVE 0x1E (-2) [10,13]
	SCOORD sB [11, 10]
	MOVE 0x1E (-2) [10,12]
	SCOORD sB [14, 8]  //Old lady moves next to Amelia
	MOVE 0x1E (-2) [13,10]
	MusicChange(0x3E7)
	STAL 60
	Highlight(Amelia)
	TalkConvo(BrigandAme)
	SCOORD sB [9,9]
	MOVE 0x1E (-2) [10,9]
	TalkConvo(BrigandANGRY)
	SCOORD sB [10,9]
	MOVE 0x1E (-2) [11,9]
	WARPOUT [12,9]
	REMOVEUNIT Amelia
	ENDWARP
	
	WARPIN [14,9]
	LOAD1 1 AmeliaCutscene
	ENDWARP
	
	TalkConvo(AmeCounter)
	
	WARPOUT [14,9]
	REMOVEUNIT Amelia
	ENDWARP
	
	FADI 60
	CLEARALL
	MuteMusic
	LOMA 0x4E
	CAMERA [4,5]
	FadeBackBlack
	WARPIN [4,5]
	LOAD1 1 AmeliaCalli
	STAL 120
	MusicChange(0x318)
	TalkConvo(AmeEnter)
	
	
	
	
	
	FadeBlack
	LOMA 0x0
	FadeBackBlack

	LOAD1 0x1 PlayerUnits
	ENUN

	LOAD2 0 EnemyUnits
        ENUN

	ENDA

EndingScene:
	MNC2 1
	NoFade
	ENDA