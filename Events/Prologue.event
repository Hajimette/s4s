	FadeBlack
	LOMA 0x0
	CAM1 [11,9]
	CLEARALL
	LOAD1 0 EnemyUnits
	LOAD1 0x1 PlayerUnits
	LOAD1 0x1 Boatan
	FadeBackBlack
	STAL 60
	CAM1 [13,21]
	STAL 15
	MusicChange(0x28)
	LOAD1 1 ZetaPrologue
	TalkConvo(bruhPrologue)
	SCOORD sB [13, 22]
	MOVE 0x34 (-2) [14,25]
	SCOORD sB [15, 22]
