ZetaPrologueSelect:
CHECK_ACTIVE
	SVAL s1 0x32
	BEQ 1 s1 sC
	ENUF 11 // unset completion flag if unit selected isn't Miko
	GOTO 2
	LABEL 1
	TextBox(ZetaWarningPrologue)
	LABEL 2
	NoFade
ENDA


BeginningScene:
SetBackground(0x35)
FadeBackBlack
CenterTextbox(OpeningMonologue)
FadeBlack
STAL 60
	LOMA 0x4D 
	CAM1 [13,9]
	MUSS 0x4C
	LOAD1 0x1 GrassCutsceneUnit
	FadeBackBlack
	ENUT 7
	ENUT 8
	ENUT 9
	ENUT 0xA
	ENUT 0xB
	
	LABEL 10
	ASMC 0x8003D21 //Text_ResetTileAllocation
	CallMenu(PrologueMenu)
	
	BEQ 2 sC s7 //Jumps to label 2, 1RN 
	
	SVAL s7 1
	BEQ 3 sC s7  //Casual
	
	SVAL s7 2
	BEQ 4 sC s7 //Fixed
	
	SVAL s7 3
	BEQ 5 sC s7 // 0% Growths
	
	SVAL s7 4 // 100% Growths
	BEQ 6 sC s7

	
	SVAL s7 5
	BEQ 7 sC s7 //Reset
	
	SVAL s7 6
	BEQ 8 sC s7 //Beging
	
	
	LABEL 2
	ENUT 0xB1 //1RN
	ENUF 7
	GOTO 10
	
	Label 3
	ENUT 0xB0 //Filthy Casual
	ENUF 8
	GOTO 10
	
	LABEL 4
	ENUT 0xef //Fixed
	ENUF 9
	GOTO 10
	
	LABEL 5
	ENUT 0xb7 //0% Growths
	ENUF 0xA
	ENUF 0xB
	TextBox(ZeroConvo)
	GOTO 10
	
	LABEL 6
	ENUT 0xb8 //100% Growths
	ENUF 0xB
	ENUF 0xA
	TextBox(HundredConvo)
	GOTO 10
	
	LABEL 7
	TextBox(FlagsReset)
	TEXTEND
	REMA
	ENUF 0xB0
	ENUF 0xB1
	ENUF 0xEF
	ENUT 7
	ENUT 8
	ENUT 9
	ENUT 0xA
	ENUT 0xB
	GOTO 10
	
	LABEL 8
	TextBox(AreYouSure)
	CallMenu(ImSureMenu)
	SVAL s7 1
	BNE 10 sC s7 // Go back to LABEL 10 if yes isn't selected

     //this is where the contents after LABEL 8 would go, no longer needing LABEL 8.	
	
	STAL 180

	LOAD1 0x1 AmeGrass
	STAL 20
	PlayEmotionEffect(Amelia,DotDotDotEffect)
	STAL 45
	TalkConvo(AmeliaOldLady)
	LOAD1 0x1 BrigandsCutscene
	PlayEmotionEffect(0xAA,ExclamationEffect)
	STAL 45
	SCOORD sB [13, 8]
	MOVE 0x1E (-2) [12,9] //Ame moves to the tree
	SCOORD sB [8, 10]
	MOVE 0x1E (-2) [10,13]
	SCOORD sB [11, 10]
	MOVE 0x1E (-2) [10,12]
	SCOORD sB [14, 8]  //Old lady moves next to Amelia
	MOVE 0x1E (-2) [13,10]
	MusicChange(0x3E7)
	STAL 60
	Highlight(Amelia)
	TalkConvo(BrigandAme)
	SCOORD sB [9,9]
	MOVE 0x1E (-2) [10,9]
	TalkConvo(BrigandANGRY)
	SCOORD sB [10,9]
	MOVE 0x1E (-2) [11,9]
	WARPOUT [12,9]
	REMOVEUNIT Amelia
	ENDWARP
	
	WARPIN [14,9]
	LOAD1 1 AmeliaCutscene
	ENDWARP
	
	TalkConvo(AmeCounter)
	
	WARPOUT [14,9]
	REMOVEUNIT Amelia
	ENDWARP
	
	FADI 60
	CLEARALL
	MuteMusic
	LOMA 0x4E //Snow Cutscene
	CAMERA [8,7]
	FadeBackBlack
	WARPIN [8,7]
	LOAD1 1 AmeliaCalli
	STAL 120
	MusicChange(0x318)
	TalkConvo(AmeEnter)
	
	
	
	
	
	SCOORD sB [8, 7]   //Grabs ame's coords
	MOVE 0x1E (-2) [8,6] //idk what -2 is I assume its how fast
	ENUN
	PlayEmotionEffect(Amelia,QuestionEffect)
	STAL 45
	TalkConvo(AmeQuestion)
	CAMERA [12,4]
	LOAD1 1 SansCutin
	ENUN
	TalkConvo(NousagiComeOut)
	CAMERA [8,7]
	PlayEmotionEffect(Amelia,QuestionEffect)
	STAL 45
	Text(AmeBigBruhMoment)
	SCOORD sB [11, 3]
	MOVE 0x1E (-2) [9,5]
	SCOORD sB [11, 4]
	MOVE 0x1E (-2) [10,6]
	ENUN
	Text(NoticeMeSenpai)
	CAM1 [3,2]
	CameraCursorLocation(3,2,60)
	LOAD1 1 SansMove
	Text(NousagiChp1Wtf)
	SCOORD sB [3, 4]
	MOVE 0x1E (-2) [6,6]
	SCOORD sB [2, 3]
	MOVE 0x1E (-2) [7,5]
	ENUN
	CAM1 [8,7]
	LOAD1 1 CalliopeIntervenes 
	Text(NousagiChp1Lockherup)
	WARPOUT [6,6]
	ENDWARP
	REMOVEUNIT Amelia
	WARPIN [7,8]
	LOAD1 1 AmeWarpsIn
	ENDWARP
	BREAKING_SACRED_STONE Amelia
	STAL 45
	PlayEmotionEffect(Amelia,ExclamationEffect)
	STAL 45
	MuteMusic
	TalkConvo(AmePanik)
	BREAKING_SACRED_STONE Amelia
	STAL 45
	BREAKING_SACRED_STONE Amelia
	STAL 45
	TalkConvo(HUH)
	CUSE 0xAA
	CUSE 0xBD
	CUSE 0xb8
	CUSE 0xb9
	CUSE 0xd0
	CUSE 0xd1
	STAL 45
	FadeBlack
	MusicChange(0x31)
	CLEARALL
	SetBackground(SnowField)        //FIX FIX FIX FIX
	FadeBackBlack
	TalkConvo(WhatThe)
	FadeBlack
	STAL 60
	SetBackground(Dungeon)  
	MuteMusic
	FadeBackBlack
	STAL 90
