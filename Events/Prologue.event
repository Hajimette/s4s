//Skip very begining world map - Contro
PUSH
ORG $A39768
EVBIT_MODIFY 0x1
SKIPWN
ENDA
POP


//ALIGN 4
//NewChName:
//String("Prologue: Stranded")
//BYTE 0


SetChapterEvents(PrologueEvent, PointerList)

PointerList:
	POIN TurnBasedEvents
	POIN CharacterBasedEvents
	POIN LocationBasedEvents
	POIN MiscBasedEvents
	POIN Dunno1 Dunno2 Dunno3 Tutorial
	POIN Traps1 Traps2
	POIN PlayerUnits PlayerUnits  //This unit group determines the number and position of deployment slots when there is a prep screen
	POIN $0 $0 $0
	POIN $0 $0 $0
	POIN BeginningScene EndingScene

TurnBasedEvents:

	END_MAIN

ALIGN 32
CharacterBasedEvents:

	END_MAIN

MiscBasedEvents:
	CauseGameOverIfLordDies
        DefeatBoss(EndingScene)


	END_MAIN

LocationBasedEvents:

	END_MAIN

Dunno1:

	END_MAIN

Dunno2:

	END_MAIN

Dunno3:

	END_MAIN

Tutorial:

	END_MAIN

PlayerUnits:

	UNIT Amelia 0x1 Amelia Level(1,Ally,False) [7,5] 0x0 0x0 0x0 0x1 [Vulnerary,0x0] NoAI


        UNIT

EnemyUnits:

	UNIT 0x52 0x52 0x53 Level(1,Enemy,True) [7,17] 0x0 0x0 0x0 0x0 [Vulnerary] NoAI

        UNIT

GrassCutsceneUnit:

	UNIT 0xAA 0x70 0xAB Level(1,NPC,False) [14,9] 0x0 0x0 0x0 0x0 [0,0] NoAI

	UNIT 0xAB 0x70 0xAB Level(1,NPC,False) [11,10] 0x0 0x0 0x0 0x0 [0,0] NoAI

	UNIT 0xAB 0x6f 0xAB Level(1,NPC,False) [13,12] 0x0 0x0 0x0 0x0 [0,0] NoAI

	UNIT 0xAB 0x6e 0xAB Level(1,NPC,False) [13,13] 0x0 0x0 0x0 0x0 [0,0] NoAI

	UNIT

AmeGrass:
	UNIT Amelia 0x1 Amelia Level(1,Ally,False) [13,7] 0x0 0x0 0x0 0x1 [Vulnerary,0x0] NoAI

	UNIT
Traps1:
	ENDTRAP
	ALIGN 4

Traps2:
	ENDTRAP
	ALIGN 4

BeginningScene:

	LOMA 0x4E 
	LOAD1 0x1 GrassCutsceneUnit
	ENUN
	FadeBackBlack

	LOAD1 0x1 AmeGrass
	ENUN
	
	
	FadeBlack
	LOMA 0x4E 
	FadeBackBlack
	
	
	FadeBlack
	LOMA 0x1
	FadeBackBlack

	LOAD1 0x1 PlayerUnits
	ENUN

	LOAD2 0 EnemyUnits
        ENUN

	ENDA

EndingScene:
	MNC2 1
	NoFade
	ENDA