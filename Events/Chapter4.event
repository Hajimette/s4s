	SoundEffect(0xBF)
	Draw(FireAnimID,1,6)
	STAL 15
	SoundEffect(0x123)
	TILECHANGE 0
	STAL 30
	PlayEmotionEffect(0x1,ExclamationEffect)
	STAL 45
