EndingScene:
FadeBlack
DisableFreeMovement
MuteMusic
SoundEffect(0x4A)
EnactAutoRepair
SetBackground(CampfireWinter)
FadeBackBlack
Text(BotanAmeINTLD1)
STAL 30
CHECK_ALIVE 0x10 //RBC
SVAL s7 0
BEQ 1 sC s7
	CHECK_ALIVE 0x11 //Checks if Risu is Alive
	SVAL s7 0
	BEQ 2 sC s7
	CHECK_ALIVE 0x19 //LAMY
	SVAL s7 0
	BEQ 3 sC s7
Text(InterludeEndAll3)	//Dialogue here if all 3 are alive
CALL ResistCutsceneInterlude1
FadeBlack
LOMA 0x4
SoundEffect(0x4A)
CLEARALL
SetBackground(CampfireWinter)
FadeBackBlack
Text(InterludeEndAll32)

GOTO 67
LABEL 3
Text(InterludeEndRBCRisu)	//Dialogue if Lamy ded but RBC/TreeRat is alive
CALL ResistCutsceneInterlude1
FadeBlack
LOMA 0x4
SoundEffect(0x4A)
CLEARALL
SetBackground(CampfireWinter)
FadeBackBlack
Text(InterludeEndRBCRisu2)
GOTO 67
LABEL 2
CHECK_ALIVE 0x19 // RBC Alive but Risu ded
SVAL s7 0
BEQ 4 sC s7
Text(InterludeLamyRBC)
CALL ResistCutsceneInterlude1
FadeBlack
LOMA 0x4
SoundEffect(0x4A)
CLEARALL
SetBackground(CampfireWinter)
FadeBackBlack
Text(InterludeLamyRBC2)
GOTO 67
LABEL 1 // Here if RBC is DEAD
CHECK_ALIVE 0x11
SVAL s7 0
BEQ 5 sC s7 // Risu alive
CHECK_ALIVE 0x19 // Checks for Lamy
SVAL s7 0
BEQ 7 sC s7
Text(InterludeLamyRisu) // Risu and Lamy are alive only
CALL ResistCutsceneInterlude1
FadeBlack
LOMA 0x4
SoundEffect(0x4A)
CLEARALL
SetBackground(CampfireWinter)
FadeBackBlack
Text(InterludeLamyRisu2)
GOTO 67
LABEL 7 // Risu alive only
Text(InterludeRisu)
CALL ResistCutsceneInterlude1
FadeBlack
LOMA 0x4
SoundEffect(0x4A)
CLEARALL
SetBackground(CampfireWinter)
FadeBackBlack
Text(InterludeRisu2)
GOTO 67
LABEL 5 //Risu and RBC are DEAD
CHECK_ALIVE 0x19 
	SVAL s7 0
	BEQ 6 sC s7 // Lamy Alive only
Text(InterludeLamy)
CALL ResistCutsceneInterlude1
FadeBlack
LOMA 0x4
SoundEffect(0x4A)
CLEARALL
SetBackground(CampfireWinter)
FadeBackBlack
Text(InterludeLamy2)
GOTO 67
LABEL 4 //RBC Alive Only
Text(InterludeRBC)
CALL ResistCutsceneInterlude1
FadeBlack
LOMA 0x4
SoundEffect(0x4A)
CLEARALL
SetBackground(CampfireWinter)
FadeBackBlack
Text(InterludeRBC2)
GOTO 67
LABEL 6 //All 3 are DEAD
STAL 60
Text(InterludeEndBotanAme)
CALL ResistCutsceneInterlude1
FadeBlack
LOMA 0x4
SoundEffect(0x4A)
CLEARALL
SetBackground(CampfireWinter)
FadeBackBlack
Text(InterludeEndBotanAme2)
LABEL 67
FadeBlack
SetBackground(SnowFieldNight)
FadeBackBlack
Text(IroKoyoInterlude1)
FadeBlack
MuteMusic
SetBackground(Dungeon)
FadeBackBlack
MusicChange(0x3E3)
Text(ChamaChp4End)
FadeBlack
	MNC2 5
	NoFade
	ENDA

